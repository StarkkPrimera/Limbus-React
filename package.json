{
  "name": "02-limbus-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "13.5.0",
    "bootstrap": "5.3.8",
    "react": "19.2.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.0",
    "react-hook-form": "7.64.0",
    "react-router-dom": "7.9.4",
    "react-scripts": "5.0.1",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "test:coverage": "react-scripts test --watchAll=false --runInBand --coverage"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.js",
          "**/*.test.jsx"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/setupTests.js",
      "!src/**/*.test.{js,jsx}",
      "!src/data/characters.mock.js"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    }
  },
  "overrides": {
    "typescript": "4.9.5"
  }
}
